# Copy to deploy/.env for a try on this machine; for a server run
#   deploy/make-env.sh https://<site address> [<domain>]
# which writes deploy/.env with random passwords.

# ":80" — plain HTTP; a domain name (twin.example.com) — automatic HTTPS
TWIN_SITE=:80
TWIN_HTTP_PORT=8090
TWIN_HTTPS_PORT=8453
# the address users open (sign-in redirects back to it), without a trailing slash
TWIN_PUBLIC_URL=http://localhost:8090

# Sign-in (Keycloak, realm "twin"; its admin console: $TWIN_PUBLIC_URL/kc/admin/)
KEYCLOAK_ADMIN=kcadmin
KEYCLOAK_ADMIN_PASSWORD=kcadmin
TWIN_OIDC_CLIENT_SECRET=dev-client-secret
# the first user (the system administrator; asked to change the password on first sign-in)
TWIN_ADMIN_USER=admin
TWIN_ADMIN_PASSWORD=admin
# signs the short-lived sign-in state and encrypts stored tokens (any long random string)
TWIN_SECRET=dev-secret-change-me

# PostgreSQL: the superuser, then a password for the database of each service
POSTGRES_PASSWORD=twin
TWIN_DB_PASSWORD_KEYCLOAK=keycloak
TWIN_DB_PASSWORD_GATEWAY=gateway
TWIN_DB_PASSWORD_PING=ping
# -- passwords of new databases go above this line --

# S3-compatible storage (the s3 service)
TWIN_S3_ACCESS_KEY=twin
TWIN_S3_SECRET_KEY=twin-secret

# where backups go (deploy/backup.sh)
TWIN_BACKUP_DIR=./backups
