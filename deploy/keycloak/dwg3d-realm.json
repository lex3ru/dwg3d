{
  "realm": "dwg3d",
  "enabled": true,
  "displayName": "Планы → 3D",
  "registrationAllowed": false,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "resetPasswordAllowed": false,
  "rememberMe": true,
  "bruteForceProtected": true,
  "sslRequired": "external",
  "internationalizationEnabled": true,
  "supportedLocales": ["ru", "en"],
  "defaultLocale": "ru",
  "ssoSessionIdleTimeout": 86400,
  "ssoSessionMaxLifespan": 1209600,
  "ssoSessionIdleTimeoutRememberMe": 1209600,
  "ssoSessionMaxLifespanRememberMe": 2592000,
  "roles": {
    "realm": [
      {"name": "admin", "description": "Администратор dwg3d: все проекты и каталог"},
      {"name": "catalog_admin", "description": "Редактирование каталога оборудования"}
    ]
  },
  "clients": [
    {
      "clientId": "dwg3d",
      "name": "Планы → 3D",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "${DWG3D_OIDC_CLIENT_SECRET}",
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "frontchannelLogout": true,
      "redirectUris": ["${DWG3D_PUBLIC_URL}/api/auth/callback", "${DWG3D_DEV_URL:http://localhost:5174}/api/auth/callback"],
      "webOrigins": ["${DWG3D_PUBLIC_URL}"],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "${DWG3D_PUBLIC_URL}/*##${DWG3D_DEV_URL:http://localhost:5174}/*"
      }
    }
  ],
  "users": [
    {
      "username": "${DWG3D_ADMIN_USER:admin}",
      "enabled": true,
      "emailVerified": true,
      "firstName": "Администратор",
      "credentials": [{"type": "password", "value": "${DWG3D_ADMIN_PASSWORD}", "temporary": true}],
      "realmRoles": ["default-roles-dwg3d", "admin"]
    }
  ]
}
