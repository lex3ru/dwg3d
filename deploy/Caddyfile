# HTTPS (8.4 п. 1). CADDY_TLS: internal — свой сертификат для локальной сети (корневой
# сертификат ставится на устройства, его можно скачать по http://<сервер>/ca.crt);
# адрес электронной почты — настоящий сертификат Let's Encrypt для доступа извне (8.5 п. 3).
{
	auto_https disable_redirects
}

{$SITE_ADDRESS} {
	tls {$CADDY_TLS}
	encode zstd gzip
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy same-origin
		-Server
	}
	# Тело запроса (R-014, ADR-0012). Вход и лимит вида файла приложение проверяет само до
	# приёма; здесь — вторая линия: общий предел файла (300 МБ) и запас на форму, у пакета
	# переноса здания — верхняя граница его настройки (10 240 МБ)
	@transfer path /api/transfer/check
	request_body @transfer {
		max_size 10241MiB
	}
	@other not path /api/transfer/check
	request_body @other {
		max_size 301MiB
	}
	reverse_proxy app:8000
}

:80 {
	handle /ca.crt {
		root * /data/caddy/pki/authorities/local
		rewrite * /root.crt
		header Content-Type application/x-x509-ca-cert
		file_server
	}
	handle {
		redir {$PUBLIC_URL}{uri} permanent
	}
}
