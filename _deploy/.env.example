# ---------------------------------------------------------------------------
# «Поэтажные планы → 3D» — настройки сервера.
# Скопируйте в .env и заполните. Пароли и секреты можно сгенерировать:
#   scripts/gen-secrets.sh >> .env      (затем удалите пустые строки-дубли выше)
# ---------------------------------------------------------------------------

# Адрес, по которому пользователи открывают систему (без / в конце).
DWG3D_PUBLIC_URL=https://plans.example.com

# Что слушает встроенный Caddy:
#   доменное имя (plans.example.com) — сам получит и продлит сертификат Let's Encrypt
#     (нужны открытые порты 80 и 443 и DNS-запись на этот сервер);
#   :80 — только HTTP, если TLS завершает внешний прокси/балансировщик.
DWG3D_SITE=plans.example.com
DWG3D_HTTP_PORT=80
DWG3D_HTTPS_PORT=443

# PostgreSQL (внутри сети docker, наружу не открыт)
POSTGRES_PASSWORD=

# S3-хранилище файлов (RustFS, внутри сети docker)
DWG3D_S3_ACCESS_KEY=dwg3d
DWG3D_S3_SECRET_KEY=

# Keycloak: администратор консоли ($DWG3D_PUBLIC_URL/auth/admin/, realm master)
KEYCLOAK_ADMIN=kcadmin
KEYCLOAK_ADMIN_PASSWORD=
# Секрет клиента dwg3d в realm (используется при первом импорте realm)
DWG3D_OIDC_CLIENT_SECRET=
# Первый пользователь приложения — глобальный администратор
# (временный пароль: Keycloak попросит сменить при первом входе)
DWG3D_ADMIN_USER=admin
DWG3D_ADMIN_PASSWORD=

# Ключ подписи состояния входа (длинная случайная строка)
DWG3D_SECRET=

# Сборка моделей: потоков в одном контейнере worker
DWG3D_WORKER_THREADS=2
# Лимит загружаемого файла, МБ
DWG3D_MAX_UPLOAD_MB=200

# Резервные копии: каталог на хозяине, сколько дампов хранить, интервал (с)
DWG3D_BACKUP_DIR=./backups
DWG3D_BACKUP_KEEP=14
DWG3D_BACKUP_INTERVAL=86400

# Образы (если собираются в своём реестре): имя и тег
DWG3D_IMAGE_API=dwg3d-api
DWG3D_IMAGE_WEB=dwg3d-web
DWG3D_TAG=latest

# ODA File Converter (необязательно, нужен только для сохранения в DWG):
# путь к исполняемому файлу внутри контейнера, см. README.md
DWG3D_ODA=
