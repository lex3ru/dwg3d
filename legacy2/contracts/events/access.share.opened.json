{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "access.share.opened",
  "description": "Ссылку открыли: гость начал просмотр. subject — ссылка; building_id (и floor_id) — в конверте. address — откуда открыли, если шлюз его знает; note — кому выдана ссылка.",
  "type": "object",
  "required": [
    "share_id",
    "scope"
  ],
  "additionalProperties": false,
  "properties": {
    "share_id": {
      "type": "string",
      "format": "uuid"
    },
    "scope": {
      "type": "object",
      "required": [
        "kind",
        "id"
      ],
      "additionalProperties": false,
      "properties": {
        "kind": {
          "enum": [
            "building",
            "floor",
            "room"
          ]
        },
        "id": {
          "type": "string",
          "format": "uuid"
        }
      }
    },
    "address": {
      "type": [
        "string",
        "null"
      ]
    },
    "note": {
      "type": "string"
    }
  }
}
