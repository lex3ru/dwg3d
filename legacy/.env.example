# Copy to .env for a try on this machine; for a server run
#   deploy/make-env.sh https://<site address> [<domain>]
# which writes .env with random passwords. With these values the API starts
# only when DWG3D_PUBLIC_URL is localhost.

# ":80" — plain HTTP; a domain name (plan.example.com) — automatic HTTPS
DWG3D_SITE=:80
DWG3D_HTTP_PORT=8088
DWG3D_HTTPS_PORT=8443
# the address users open (sign-in redirects back to it), without a trailing slash
DWG3D_PUBLIC_URL=http://localhost:8088

# Sign-in (Keycloak, realm "dwg3d"; its admin console: $DWG3D_PUBLIC_URL/auth/admin/)
KEYCLOAK_ADMIN=kcadmin
KEYCLOAK_ADMIN_PASSWORD=kcadmin
DWG3D_OIDC_CLIENT_SECRET=dev-client-secret
# the first user of the app (a global admin; asked to change the password on first sign-in)
DWG3D_ADMIN_USER=admin
DWG3D_ADMIN_PASSWORD=admin
# signs the short-lived sign-in state (any long random string)
DWG3D_SECRET=dev-secret-change-me

POSTGRES_PASSWORD=dwg3d

# S3-compatible storage (the s3 service) for drawings, models and exports
DWG3D_S3_ACCESS_KEY=dwg3d
DWG3D_S3_SECRET_KEY=dwg3d-secret

DWG3D_WORKER_THREADS=2

# Backups (the backup service): database dumps and a mirror of the files
DWG3D_BACKUP_DIR=./backups
DWG3D_BACKUP_KEEP=14
# ODA File Converter (optional, better DWG support): path inside the
# container of a binary mounted into it (see docs/DOCKER.md)
DWG3D_ODA=
