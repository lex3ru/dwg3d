{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "planning.variant.applied",
  "description": "Вариант применён: сколько операций выполнено и сколько отклонено. subject — вариант.",
  "type": "object",
  "required": [
    "variant_id",
    "applied",
    "refused"
  ],
  "additionalProperties": false,
  "properties": {
    "variant_id": {
      "type": "string",
      "format": "uuid"
    },
    "applied": {
      "type": "integer"
    },
    "refused": {
      "type": "integer"
    }
  }
}
