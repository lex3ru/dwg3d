{
  "components": {
    "schemas": {
      "Area": {
        "properties": {
          "id": {
            "title": "Id",
            "type": "string"
          },
          "kind": {
            "description": "building, floor или room",
            "title": "Kind",
            "type": "string"
          }
        },
        "required": [
          "kind",
          "id"
        ],
        "title": "Area",
        "type": "object"
      },
      "Cabinet": {
        "properties": {
          "attention": {
            "description": "Объекты, требующие внимания: неисправные, без места, с незаполненными свойствами",
            "items": {
              "additionalProperties": true,
              "type": "object"
            },
            "title": "Attention",
            "type": "array"
          },
          "mine": {
            "description": "Объекты, за которые я отвечаю",
            "items": {
              "additionalProperties": true,
              "type": "object"
            },
            "title": "Mine",
            "type": "array"
          },
          "partial": {
            "description": "Сервисы, не ответившие: их части в ответе нет",
            "items": {
              "type": "string"
            },
            "title": "Partial",
            "type": "array"
          },
          "person_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "Человек, который вошёл; null — учётной записи нет в справочнике",
            "title": "Person Id"
          },
          "rooms": {
            "description": "Мои помещения: на которые есть право (пусто, если видно всё здание)",
            "items": {
              "$ref": "#/components/schemas/CabinetRoom"
            },
            "title": "Rooms",
            "type": "array"
          },
          "whole": {
            "description": "Видно всё здание (администратор или право на здание целиком)",
            "title": "Whole",
            "type": "boolean"
          }
        },
        "required": [
          "person_id",
          "whole",
          "rooms",
          "attention",
          "mine",
          "partial"
        ],
        "title": "Cabinet",
        "type": "object"
      },
      "CabinetRoom": {
        "properties": {
          "floor_id": {
            "title": "Floor Id",
            "type": "string"
          },
          "floor_name": {
            "title": "Floor Name",
            "type": "string"
          },
          "id": {
            "title": "Id",
            "type": "string"
          },
          "level": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Level"
          },
          "name": {
            "title": "Name",
            "type": "string"
          },
          "number": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Number"
          }
        },
        "required": [
          "id",
          "name",
          "number",
          "floor_id",
          "floor_name",
          "level"
        ],
        "title": "CabinetRoom",
        "type": "object"
      },
      "DrawingReport": {
        "properties": {
          "drawing_id": {
            "format": "uuid",
            "title": "Drawing Id",
            "type": "string"
          },
          "format": {
            "default": "dxf",
            "pattern": "^(dxf|dwg)$",
            "title": "Format",
            "type": "string"
          }
        },
        "required": [
          "drawing_id"
        ],
        "title": "DrawingReport",
        "type": "object"
      },
      "GuestLook": {
        "properties": {
          "building_id": {
            "title": "Building Id",
            "type": "string"
          },
          "building_name": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "null — сервис зданий не ответил",
            "title": "Building Name"
          },
          "expires_at": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "До какого времени действует ссылка",
            "title": "Expires At"
          },
          "floor_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "Этаж, план которого виден (для этажа и помещения)",
            "title": "Floor Id"
          },
          "scope": {
            "$ref": "#/components/schemas/Area",
            "description": "Что открывает ссылка"
          }
        },
        "required": [
          "building_id",
          "building_name",
          "scope",
          "floor_id",
          "expires_at"
        ],
        "title": "GuestLook",
        "type": "object"
      },
      "GuestMe": {
        "properties": {
          "guest": {
            "$ref": "#/components/schemas/GuestLook"
          },
          "kind": {
            "const": "guest",
            "title": "Kind",
            "type": "string"
          },
          "name": {
            "title": "Name",
            "type": "string"
          }
        },
        "required": [
          "kind",
          "name",
          "guest"
        ],
        "title": "GuestMe",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "LoggedOut": {
        "properties": {
          "url": {
            "description": "Куда перейти, чтобы завершить и сеанс Keycloak",
            "title": "Url",
            "type": "string"
          }
        },
        "required": [
          "url"
        ],
        "title": "LoggedOut",
        "type": "object"
      },
      "Me": {
        "properties": {
          "kind": {
            "const": "user",
            "default": "user",
            "title": "Kind",
            "type": "string"
          },
          "partial": {
            "description": "Сервисы, не ответившие: соответствующих частей в ответе нет",
            "items": {
              "type": "string"
            },
            "title": "Partial",
            "type": "array"
          },
          "person": {
            "anyOf": [
              {
                "additionalProperties": true,
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "description": "Запись справочника людей; null — учётной записи нет в справочнике",
            "title": "Person"
          },
          "reason": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "Почему нет записи: unknown, ambiguous, left",
            "title": "Reason"
          },
          "scopes": {
            "anyOf": [
              {
                "additionalProperties": true,
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "description": "Области доступа: назначения и здания, план которых виден",
            "title": "Scopes"
          },
          "user": {
            "$ref": "#/components/schemas/User"
          }
        },
        "required": [
          "user",
          "person",
          "reason",
          "scopes",
          "partial"
        ],
        "title": "Me",
        "type": "object"
      },
      "ServiceStatus": {
        "properties": {
          "db": {
            "anyOf": [
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ],
            "description": "Его база доступна",
            "title": "Db"
          },
          "ms": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "description": "Время ответа",
            "title": "Ms"
          },
          "name": {
            "title": "Name",
            "type": "string"
          },
          "nats": {
            "anyOf": [
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ],
            "description": "Он подключён к шине событий",
            "title": "Nats"
          },
          "ok": {
            "description": "Сервис отвечает",
            "title": "Ok",
            "type": "boolean"
          }
        },
        "required": [
          "name",
          "ok",
          "db",
          "nats",
          "ms"
        ],
        "title": "ServiceStatus",
        "type": "object"
      },
      "SystemStatus": {
        "properties": {
          "services": {
            "items": {
              "$ref": "#/components/schemas/ServiceStatus"
            },
            "title": "Services",
            "type": "array"
          },
          "viewers": {
            "description": "Сколько браузеров слушают поток событий",
            "title": "Viewers",
            "type": "integer"
          }
        },
        "required": [
          "services",
          "viewers"
        ],
        "title": "SystemStatus",
        "type": "object"
      },
      "User": {
        "properties": {
          "email": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Email"
          },
          "is_admin": {
            "description": "Администратор системы",
            "title": "Is Admin",
            "type": "boolean"
          },
          "login": {
            "title": "Login",
            "type": "string"
          },
          "name": {
            "title": "Name",
            "type": "string"
          },
          "roles": {
            "description": "Роли приложения из Keycloak",
            "items": {
              "type": "string"
            },
            "title": "Roles",
            "type": "array"
          },
          "sub": {
            "title": "Sub",
            "type": "string"
          }
        },
        "required": [
          "sub",
          "login",
          "name",
          "email",
          "roles",
          "is_admin"
        ],
        "title": "User",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      }
    }
  },
  "info": {
    "title": "Шлюз",
    "version": "1"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/me": {
      "get": {
        "operationId": "me_api_me_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "anyOf": [
                    {
                      "$ref": "#/components/schemas/Me"
                    },
                    {
                      "$ref": "#/components/schemas/GuestMe"
                    }
                  ],
                  "title": "Response Me Api Me Get"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Кто вошёл (или гость по ссылке)",
        "tags": [
          "me"
        ]
      }
    },
    "/api/reports/assets.xlsx": {
      "get": {
        "operationId": "assets_xlsx_api_reports_assets_xlsx_get",
        "parameters": [
          {
            "in": "query",
            "name": "building_id",
            "required": true,
            "schema": {
              "format": "uuid",
              "title": "Building Id",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet": {}
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Список объектов в Excel по тем же фильтрам, что у списка; свойства — отдельными столбцами",
        "tags": [
          "reports"
        ]
      }
    },
    "/api/reports/buildings/{building_id}/drawing": {
      "post": {
        "operationId": "drawing_with_objects_api_reports_buildings__building_id__drawing_post",
        "parameters": [
          {
            "in": "path",
            "name": "building_id",
            "required": true,
            "schema": {
              "format": "uuid",
              "title": "Building Id",
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/DrawingReport"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Чертёж с объектами (DXF или DWG): объекты — блоками с атрибутами на своих местах",
        "tags": [
          "reports"
        ]
      }
    },
    "/api/reports/rooms/{room_id}/sheet.pdf": {
      "get": {
        "operationId": "room_sheet_api_reports_rooms__room_id__sheet_pdf_get",
        "parameters": [
          {
            "in": "path",
            "name": "room_id",
            "required": true,
            "schema": {
              "format": "uuid",
              "title": "Room Id",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/pdf": {}
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Ведомость помещения в PDF: объекты, номера, состояние, ответственные, место для подписи",
        "tags": [
          "reports"
        ]
      }
    },
    "/api/stream": {
      "get": {
        "operationId": "stream_api_stream_get",
        "responses": {
          "200": {
            "content": {
              "text/event-stream": {}
            },
            "description": "Successful Response"
          }
        },
        "summary": "Поток событий (Server-Sent Events)",
        "tags": [
          "stream"
        ]
      }
    },
    "/api/system/status": {
      "get": {
        "operationId": "status_api_system_status_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SystemStatus"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Состояние сервисов (администратор системы)",
        "tags": [
          "system"
        ]
      }
    },
    "/api/views/cabinet": {
      "get": {
        "operationId": "cabinet_api_views_cabinet_get",
        "parameters": [
          {
            "in": "query",
            "name": "building_id",
            "required": true,
            "schema": {
              "format": "uuid",
              "title": "Building Id",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Cabinet"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Личный кабинет в здании",
        "tags": [
          "views"
        ]
      }
    },
    "/auth/callback": {
      "get": {
        "operationId": "callback_auth_callback_get",
        "parameters": [
          {
            "in": "query",
            "name": "code",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Code"
            }
          },
          {
            "in": "query",
            "name": "state",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "State"
            }
          }
        ],
        "responses": {
          "302": {
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Завершить вход: Keycloak возвращает сюда",
        "tags": [
          "auth"
        ]
      }
    },
    "/auth/login": {
      "get": {
        "operationId": "login_auth_login_get",
        "parameters": [
          {
            "in": "query",
            "name": "next",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Next"
            }
          }
        ],
        "responses": {
          "302": {
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Начать вход: переадресация в Keycloak",
        "tags": [
          "auth"
        ]
      }
    },
    "/auth/logout": {
      "post": {
        "operationId": "logout_auth_logout_post",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LoggedOut"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Выйти; гость по ссылке выходит только из просмотра по ней",
        "tags": [
          "auth"
        ]
      }
    },
    "/q/{code}": {
      "get": {
        "operationId": "qr_q__code__get",
        "parameters": [
          {
            "in": "path",
            "name": "code",
            "required": true,
            "schema": {
              "title": "Code",
              "type": "string"
            }
          }
        ],
        "responses": {
          "302": {
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "QR-метка: без входа — на вход, затем к карточке объекта (если есть право на него)",
        "tags": [
          "qr"
        ]
      }
    },
    "/s/{token}": {
      "get": {
        "operationId": "share_s__token__get",
        "parameters": [
          {
            "in": "path",
            "name": "token",
            "required": true,
            "schema": {
              "title": "Token",
              "type": "string"
            }
          }
        ],
        "responses": {
          "302": {
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Ссылка для просмотра без учётной записи: гостевой сеанс и переход к просмотру (#/g; недействительна — #/g?invalid=1; сервис доступа недоступен — #/g?unavailable=1)",
        "tags": [
          "auth"
        ]
      }
    }
  }
}
