    "/api/planning/v1/compare": {
      "get": {
        "operationId": "compare_api_planning_v1_compare_get",
        "parameters": [
          {
            "in": "query",
            "name": "building_id",
            "required": true,
            "schema": {
              "format": "uuid",
              "title": "Building Id",
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "a",
            "required": false,
            "schema": {
              "default": "fact",
              "title": "A",
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "b",
            "required": true,
            "schema": {
              "title": "B",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": true,
                  "title": "Response Compare Api Planning V1 Compare Get",
                  "type": "object"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Сравнить два состояния (факт или вариант): что добавлено, убрано, перемещено, изменено; спецификации",
        "tags": [
          "variants"
        ]
      }
    },
